NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Llave de servicio de Supabase (Project Settings → API → service_role).
# SOLO servidor, nunca en el cliente. Sin esto no se pueden crear cuentas
# desde el panel admin ni mandar los correos de reserva: el aviso al dueño
# necesita leer su correo en `perfiles`, que la anon key no puede ver.
SUPABASE_SERVICE_ROLE_KEY=

# Confirmaciones de reserva por correo (resend.com). Sin esta variable
# los correos simplemente no se envían — la reserva funciona igual.
RESEND_API_KEY=
# Remitente propio, una vez que verifiques tu dominio en resend.com/domains.
# OJO: sin esto se usa el remitente de prueba de Resend, que SOLO entrega a
# la casilla dueña de la cuenta — ni los clientes ni los dueños de los
# negocios reciben nada. Es la diferencia entre "me llega a mí" y "funciona".
RESEND_FROM_EMAIL=
# Casilla del equipo que recibe el aviso "entró un pedido de invitación".
# Sin esta variable el aviso NO se manda: el pedido queda bien guardado,
# pero nadie se entera hasta que alguien abra /admin/invitaciones.
BOOKEA_CORREO_PEDIDOS=
# OBLIGATORIA. Es la llave de los crons (/api/auto-cobro y
# /api/recordatorios): Vercel la manda en el header Authorization al
# dispararlos. Sin ella esas rutas RECHAZAN todo — o sea, los crons
# dejan de correr. Antes pasaba lo contrario y era peor: sin la variable
# la puerta se abría sola y cualquiera podía disparar un cobro.
# Generala con: openssl rand -hex 32
CRON_SECRET=
# Opcional: el dominio real del sitio, para los links del correo
# (botón, pie de página). Por defecto usa https://bookea.lat.
NEXT_PUBLIC_SITE_URL=
# Sal secreta del contador de visitas ("12 personas visitaron este sitio
# hoy"). Con ella el servidor convierte la IP + el navegador + el día en
# un hash: la IP en claro nunca se guarda. NUNCA con NEXT_PUBLIC_ — si
# la sal es pública, el hash deja de proteger nada. Sin la variable el
# contador sigue funcionando con una sal por defecto y avisa por consola.
# Generala con: openssl rand -hex 32
VISITAS_SALT=
