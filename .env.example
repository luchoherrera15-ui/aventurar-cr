NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Confirmaciones de reserva por correo (resend.com). Sin esta variable
# los correos simplemente no se envían — la reserva funciona igual.
RESEND_API_KEY=
# Opcional: remitente propio una vez que verifiques tu dominio en
# resend.com/domains. Sin esto se usa el remitente de prueba de Resend,
# que solo entrega a la casilla dueña de la cuenta.
RESEND_FROM_EMAIL=
